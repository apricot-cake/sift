# Every dependency in package.json is written at one exact version, and this is
# what keeps it that way: without it the next `npm install <pkg>` writes a caret
# range and the pinning ends there, quietly and only for the newest entry.
#
# Pinning is already this repository's answer everywhere else. The workflow
# `uses:` are pinned to commit SHAs rather than tags, and Dependabot is the path
# updates come in by (.github/dependabot.yml — weekly, minor and patch grouped).
# A range moves a dependency with no commit saying so; a pin makes every move a
# change somebody approved.
save-exact=true
