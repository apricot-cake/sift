{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/extension-dev-hook.js\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root 'scripts/extension-dev-hook.js')\"",
            "timeout": 20,
            "statusMessage": "Sift development server readiness"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/extension-dev-hook.js\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root 'scripts/extension-dev-hook.js')\"",
            "timeout": 20,
            "statusMessage": "Checking Sift dist-dev readiness"
          }
        ]
      }
    ]
  }
}
