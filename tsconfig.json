{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // Node's built-in type stripping — which is how scripts/*.ts run at all
    // (`npm run dev`, `npm run deploy`, `npm run verify:manifest`) — cannot
    // erase enums, runtime namespaces, parameter properties or decorators; it
    // only strips type-only syntax. Failing on those here, rather than at the
    // moment a script is run, keeps every .ts file in this repo directly
    // runnable by node.
    "erasableSyntaxOnly": true,
    // Node's own globals (`process`, `Buffer`, `node:*` built-ins), which the
    // scripts and the build config need. Named explicitly because this project
    // has no other @types package whose presence would pull them in.
    //
    // "chrome" is deliberately absent. The extension APIs are reached through
    // `browser` (wxt/browser), whose types WXT ships, and leaving the chrome
    // globals undeclared is what stops a `chrome.*` call from compiling at all.
    "types": ["node"]
  }
}
