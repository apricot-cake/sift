{
  "name": "sift",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "storybook": "storybook dev --host 127.0.0.1 -p 6007 --ci --no-open --disable-telemetry",
    "build:storybook": "storybook build --output-dir .output/storybook --disable-telemetry",
    "browser:open": "node scripts/dev-browser.ts",
    "browser:status": "node scripts/dev-browser.ts --print",
    "smoke:panel": "node scripts/smoke-panel.mjs",
    "smoke:connection": "node scripts/smoke-connection.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "build": "node scripts/build-extension.ts store",
    "build:candidate": "node scripts/prepare-candidate.ts",
    "browser:candidate": "node scripts/load-candidate.ts",
    "verify:candidate": "node scripts/verify-candidate.ts",
    "package:store": "node scripts/build-extension.ts store zip",
    "deploy:local": "node scripts/deploy-extension.ts",
    "lint": "pnpm run lint:code && pnpm run lint:markdown && pnpm run lint:typos",
    "lint:code": "biome ci .",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "lint:typos": "typos",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "postinstall": "node scripts/bootstrap-i18n-types.ts && wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@wxt-dev/i18n": "0.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webext-core/fake-browser": "2.0.1",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "21.0.4",
    "markdownlint-cli2": "0.24.0",
    "puppeteer-core": "25.16.0",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.11.2"
}
