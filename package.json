{
  "name": "sift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/extension-dev-control.js ensure",
    "dev:server": "vite",
    "ext:register": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/register-extension-dev-task.ps1",
    "ext:restart": "node scripts/extension-dev-control.js restart",
    "ext:status": "node scripts/extension-dev-control.js status",
    "build": "vite build && npm run verify:manifest",
    "test": "node --test test.js && npm run verify:dev-client && npm run verify:extension-dev",
    "verify:dev-client": "node scripts/verify-dev-client.js",
    "verify:extension-dev": "node scripts/verify-extension-dev.js",
    "verify:manifest": "node scripts/verify-manifest.js"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "vite": "8.2.0"
  }
}
