{
  "name": "sift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:browser": "node scripts/dev-browser.ts",
    "build": "wxt build -b chrome && npm run verify:manifest",
    "deploy": "node scripts/deploy-extension.ts",
    "test": "tsc --noEmit && vitest run",
    "verify:manifest": "node scripts/verify-manifest.ts",
    "postinstall": "wxt prepare",
    "prepare": "node scripts/setup.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wxt": "0.21.3"
  }
}
