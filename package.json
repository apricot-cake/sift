{
  "name": "sift",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "browser:open": "node scripts/dev-browser.ts",
    "browser:status": "node scripts/dev-browser.ts --print",
    "smoke:panel": "node scripts/with-dev-browser.ts scripts/smoke-panel.mjs",
    "smoke:connection": "node scripts/with-dev-browser.ts scripts/smoke-connection.mjs",
    "test:live": "node scripts/with-dev-browser.ts node_modules/@playwright/test/cli.js test",
    "build": "node scripts/build-extension.ts store",
    "build:candidate": "node scripts/prepare-candidate.ts",
    "browser:candidate": "node scripts/with-dev-browser.ts scripts/load-candidate.ts",
    "verify:candidate": "node scripts/with-dev-browser.ts scripts/verify-candidate.ts",
    "package:store": "node scripts/build-extension.ts store zip",
    "deploy:local": "node scripts/deploy-extension.ts",
    "lint": "npm run lint:code && npm run lint:markdown && npm run lint:typos",
    "lint:code": "biome ci .",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "lint:typos": "typos",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "postinstall": "node scripts/bootstrap-i18n-types.ts && wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@wxt-dev/i18n": "0.2.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "20.14.5",
    "markdownlint-cli2": "0.23.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
