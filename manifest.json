{
  "manifest_version": 3,
  "name": "X リスト・イラストフィルター",
  "version": "0.1.0",
  "description": "Xのリスト画面を、メディア・いいね数・投稿後の時間で絞り込みます。",
  "permissions": ["storage"],
  "action": {
    "default_title": "X リスト・イラストフィルター",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["content.css"],
      "js": ["filter-core.js", "settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
