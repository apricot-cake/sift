{
  "name": "sift-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "build": "astro build && node --test scripts/build-html.test.mjs && node scripts/check-build.mjs && node scripts/check-replay.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@lucide/astro": "1.56.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.5",
    "parse5": "8.0.1",
    "typescript": "6.0.3"
  }
}
