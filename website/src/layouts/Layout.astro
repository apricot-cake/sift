---
import "@fontsource-variable/noto-sans-jp";
import "../styles/global.css";
import "../styles/product.css";

const {
  title = "sift — SNSのイラストフィルター",
  description = "X・Blueskyでイラストを探すためのSNSフィルター。対応する一覧ページで、読み込み済みの投稿をいいね数や画像の有無で絞り込めるChrome拡張機能。",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sift" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}icon-128.png`} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">本文へ移動</a>
    <slot />
  </body>
</html>
