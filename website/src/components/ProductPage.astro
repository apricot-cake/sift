---
import { Lock } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import InstallLinks from "./InstallLinks.astro";
import ReplayDemo from "./ReplayDemo.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<Layout>
  <header class="product-header">
    <a class="product-brand" href={base} aria-label="sift ホーム"><img src={`${base}icon-128.png`} width="36" height="36" alt="" /><span>sift</span></a>
    <a href="https://github.com/apricot-cake/sift" class="product-github" aria-label="siftのGitHubリポジトリ"><img src={`${base}brand/github-mark.svg`} width="24" height="24" alt="" /></a>
  </header>
  <main id="main" tabindex="-1" class="product-page">
    <section class="product-intro" aria-labelledby="product-introduction-sentence">
      <h1 id="product-introduction-sentence" class="product-page-title"><span>SNSの投稿を</span><span>条件で絞り込む</span></h1>
      <div class="product-description" data-reveal>
        <p>X・Blueskyでのイラスト探しに使えるChrome拡張機能です。</p>
      </div>
      <div data-reveal style="--reveal-delay: 160ms">
        <InstallLinks />
      </div>
    </section>

    <section class="product-demo" data-reveal aria-labelledby="product-social-heading">
      <h2 id="product-social-heading">使い方</h2>
      <p class="product-demo-description">対応するタイムラインやリストで、読み込まれた投稿をいいね数や画像の有無で絞り込みます。</p>
      <ReplayDemo />
    </section>

    <section class="product-local" data-reveal aria-labelledby="product-local-heading">
      <div class="product-local-icon"><Lock size={70} stroke-width={1.5} aria-hidden="true" /></div>
      <div>
        <h2 id="product-local-heading">絞り込みはブラウザ内で</h2>
        <p>閲覧データを外部に送信しません。</p>
      </div>
    </section>

    <section class="product-install" data-reveal aria-labelledby="product-install-heading">
      <h2 id="product-install-heading">インストール</h2>
      <p class="product-availability">無料で使えるオープンソースの拡張機能です。</p>
      <InstallLinks />
    </section>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reducedMotion.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.removeAttribute("data-reveal-pending");
        observer.unobserve(entry.target);
      }
    }, { rootMargin: "0px 0px -100px 0px" });
    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((element) => {
      // 復元したスクロール位置より上の内容だけ、再表示を省く。
      if (element.getBoundingClientRect().bottom <= 0) return;
      element.setAttribute("data-reveal-pending", "");
      // 初期表示でも、フェード開始前のスタイルを確定する。
      void element.offsetHeight;
      observer.observe(element);
      element.addEventListener("focusin", () => {
        element.removeAttribute("data-reveal-pending");
        observer.unobserve(element);
      });
    });
    reducedMotion.addEventListener("change", () => {
      if (!reducedMotion.matches) return;
      observer.disconnect();
      document.querySelectorAll("[data-reveal-pending]").forEach((element) => {
        element.removeAttribute("data-reveal-pending");
      });
    });
  }
</script>
