---
import { demoPosts } from "../data/demo-posts";
import "../styles/replay-demo.css";
import {
  ArrowLeft,
  Bell,
  ChevronDown,
  CircleMinus,
  Heart,
  House,
  Image,
  List,
  ListFilter,
  Mail,
  MessageCircle,
  Play,
  Quote,
  Repeat2,
  Search,
} from "@lucide/astro";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const image = (path: string) => `${base}${path.replace(/^\//, "")}`;
const stages = ["一覧を開く", "パネルを開く", "条件を指定", "絞り込む"];
const navigation = [House, Search, Bell, Mail, List];
---
<div class="replay-demo" data-replay-demo data-stage="0">
  <div class="replay-controls">
  <fieldset class="replay-timeline" aria-label="操作デモの再生位置" disabled>
    {stages.map((stage, index) => <button type="button" data-step={index} aria-label={`${stage}の場面から再生`} aria-current={index === 0 ? "step" : undefined}><span>{stage}</span><span class="replay-track" aria-hidden="true"><span class="replay-progress"></span></span></button>)}
  </fieldset>
  </div>
  <div class="replay-viewport">
    <div class="replay-screen" aria-label="siftの操作デモ">
      <div class="replay-browser" aria-hidden="true"><ArrowLeft aria-hidden="true" /><span class="replay-address"></span><span class="replay-extension"><img src={`${base}icon-128.png`} width="24" height="24" alt="" /></span><span>···</span></div>
      <div class="replay-workspace">
        <div class="replay-social">
          <div class="replay-social-content">
          <div class="replay-nav" aria-hidden="true">{navigation.map((Icon) => <Icon aria-hidden="true" />)}</div>
          <div class="replay-feed">
            <div class="replay-feed-tabs" aria-hidden="true"><span>おすすめ</span><span class="selected">フォロー中</span></div>
            <div class="replay-posts">{demoPosts.map((post, index) => <article class="replay-post" data-likes={post.likes}><span class={`replay-avatar avatar-${post.avatar}`} aria-hidden="true"></span><div class="replay-author"><strong>{post.name}</strong><span>{post.handle}</span><span>· {index + 1}時間</span></div><p>{post.text}</p>{post.image && <img class="replay-post-image" src={image(post.image)} width="132" height="78" alt={post.alt} />}<div class="replay-metrics"><span><MessageCircle aria-hidden="true" />{post.replies}</span><span><Repeat2 aria-hidden="true" />{post.reposts.toLocaleString("ja-JP")}</span><span><Heart aria-hidden="true" />{post.likes.toLocaleString("ja-JP")}</span></div></article>)}</div>
          </div>
          </div>
        </div>
        <aside class="replay-panel" aria-hidden="true">
          <div class="replay-panel-content">
            <section class="replay-panel-minimum">
              <h3 class="replay-label">
                <ListFilter aria-hidden="true" />
                <span data-label>最低いいね数</span>
              </h3>
              <div class="replay-field">
                <div class="replay-picker"><span class="replay-selected"><span data-value>指定なし</span><span data-selected-count>6件</span></span><ChevronDown aria-hidden="true" /></div>
                <div class="replay-menu" hidden aria-hidden="true"></div>
              </div>
              <p class="replay-panel-note" data-panel-note>読み込み済み投稿6件を集計しています</p>
            </section>
            <section class="replay-panel-group">
              <h3 class="replay-label"><Image aria-hidden="true" />コンテンツタイプ</h3>
              <div class="replay-static-select">すべて<ChevronDown aria-hidden="true" /></div>
            </section>
            <section class="replay-panel-group">
              <h3 class="replay-label"><CircleMinus aria-hidden="true" />除外条件</h3>
              <div>
                <div class="replay-setting-row"><span><MessageCircle aria-hidden="true" />返信を除外</span><span class="replay-switch"></span></div>
                <div class="replay-setting-row"><span><Quote aria-hidden="true" />引用投稿を除外</span><span class="replay-switch"></span></div>
                <div class="replay-setting-row"><span><Repeat2 aria-hidden="true" />リポストを除外</span><span class="replay-switch"></span></div>
              </div>
            </section>
          </div>
          <div class="replay-panel-footer">設定をリセット</div>
        </aside>
      </div>
      <span class="replay-cursor" aria-hidden="true"></span>
    </div>
    <div class="replay-start-overlay">
      <button type="button" class="replay-start" aria-label="デモを再生" disabled>
        <Play aria-hidden="true" />
      </button>
    </div>
  </div>
</div>
<script>
  import { initializeReplayDemos } from "../scripts/replay-demo";
  initializeReplayDemos();
</script>
