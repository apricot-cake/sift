---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const store =
  "https://chromewebstore.google.com/detail/sift/jglehalaegleehefcefnfmmbblgkomeh";
---

<div class="product-actions">
  <a href={store} class="product-store" aria-label="Chrome ウェブストアでsiftを入手"><img src={`${base}brand/cws-badge.png`} width="206" height="58" alt="Available in the Chrome Web Store" /></a>
</div>
